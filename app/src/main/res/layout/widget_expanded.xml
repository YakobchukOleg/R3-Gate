<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wroot" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/wbackground" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg" android:importantForAccessibility="no"/>
  <LinearLayout android:id="@+id/wcontent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:id="@+id/wsummary" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:id="@+id/wstatusrow">
        <TextView android:id="@+id/wstatus" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F5F4EF" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:layout_width="0dp"/>
        <ImageView android:id="@+id/wcloud" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_cloud"/>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:baselineAligned="false">
        <Chronometer android:id="@+id/wduration" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="18dp" android:textSize="42sp" android:textColor="#F5F4EF" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:maxLines="1" android:layout_weight="1"/>
        <LinearLayout android:id="@+id/wstagecolumn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_gravity="bottom" android:paddingBottom="8dp">
          <TextView android:id="@+id/wday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#F5F4EF" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
          <Chronometer android:id="@+id/wstage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="18dp" android:textSize="12sp" android:textColor="#F5F4EF" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:maxLines="1" android:layout_marginStart="4dp"/>
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/wprimaryrow" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
      <FrameLayout android:id="@+id/wprimary" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1">
        <Button android:elevation="0dp" android:stateListAnimator="@null" android:id="@+id/wstartbutton" android:layout_width="match_parent" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="48dp" android:padding="4dp" android:drawablePadding="2dp" android:background="@drawable/widget_button" android:backgroundTint="@null" android:textColor="#F5F4EF" android:text="Rozpocznij" android:textAllCaps="false" android:textSize="12sp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:gravity="center" android:maxLines="2"/>
        <Button android:elevation="0dp" android:stateListAnimator="@null" android:id="@+id/wstopbutton" android:layout_width="match_parent" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="48dp" android:padding="4dp" android:drawablePadding="2dp" android:background="@drawable/widget_button" android:backgroundTint="@null" android:textColor="#F5F4EF" android:text="Zakończ" android:textAllCaps="false" android:textSize="12sp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:gravity="center" android:maxLines="2" android:visibility="gone"/>
      </FrameLayout>
      <TextView android:id="@+id/wprimarygap" android:layout_width="8dp" android:layout_height="1dp"/>
      <ImageButton android:elevation="0dp" android:stateListAnimator="@null" android:id="@+id/wcamera" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/widget_button" android:backgroundTint="@null" android:src="@drawable/ic_widget_camera" android:contentDescription="Zrób zdjęcie"/>
    </LinearLayout>
    <TextView android:id="@+id/wverticalgap" android:layout_width="1dp" android:layout_height="8dp"/>
    <LinearLayout android:id="@+id/wactions" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal">
      <Button android:elevation="0dp" android:stateListAnimator="@null" android:id="@+id/wswitch" android:layout_width="0dp" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="48dp" android:padding="4dp" android:drawablePadding="2dp" android:background="@drawable/widget_button" android:backgroundTint="@null" android:textColor="#F5F4EF" android:text="Obiekt" android:textAllCaps="false" android:textSize="12sp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:gravity="center" android:maxLines="2" android:layout_weight="1"/>
      <TextView android:id="@+id/wgap1" android:layout_width="8dp" android:layout_height="1dp"/>
      <Button android:elevation="0dp" android:stateListAnimator="@null" android:id="@+id/wtravel" android:layout_width="0dp" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="48dp" android:padding="4dp" android:drawablePadding="2dp" android:background="@drawable/widget_button" android:backgroundTint="@null" android:textColor="#F5F4EF" android:text="Przejazd" android:textAllCaps="false" android:textSize="12sp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:gravity="center" android:maxLines="2" android:layout_weight="1"/>
      <TextView android:id="@+id/wgap2" android:layout_width="8dp" android:layout_height="1dp"/>
      <Button android:elevation="0dp" android:stateListAnimator="@null" android:id="@+id/wshopping" android:layout_width="0dp" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="48dp" android:padding="4dp" android:drawablePadding="2dp" android:background="@drawable/widget_button" android:backgroundTint="@null" android:textColor="#F5F4EF" android:text="Zakupy" android:textAllCaps="false" android:textSize="12sp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:gravity="center" android:maxLines="2" android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:orientation="vertical">
      <TextView android:id="@+id/wobject" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F5F4EF" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
      <TextView android:id="@+id/wgps" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F5F4EF" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
      <TextView android:id="@+id/wdetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F5F4EF" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
      <TextView android:id="@+id/wtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F5F4EF" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
      <TextView android:id="@+id/wstart" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F5F4EF" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
      <TextView android:id="@+id/wend" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F5F4EF" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
