<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:id="@+id/wroot" android:background="@android:color/transparent">
    <ImageView android:id="@+id/wbackground" android:layout_width="match_parent"
        android:layout_height="match_parent" android:src="@drawable/widget_bg"
        android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingLeft="14dp" android:paddingRight="14dp"
        android:paddingTop="6dp" android:paddingBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/wtitle" android:fontFamily="@font/clash_grotesk"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="WorkMeter"
                android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:id="@+id/wstatus" android:fontFamily="@font/clash_grotesk"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="● OFFLINE" android:textColor="#D1DDE0" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="1dp">
            <Chronometer android:id="@+id/wduration" android:fontFamily="@font/clash_grotesk"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="#FFFFFF"
                android:textStyle="bold" android:textSize="29sp"/>
            <Chronometer android:id="@+id/wstage" android:fontFamily="@font/clash_grotesk"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFC7B8" android:textSize="10sp" android:visibility="gone"/>
        </LinearLayout>
        <TextView android:id="@+id/wobject" android:fontFamily="@font/clash_grotesk"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Gotowy do pracy" android:textColor="#F0F4F5"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
        <LinearLayout android:id="@+id/wdetails" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="1dp">
            <TextView android:id="@+id/wstart" android:fontFamily="@font/clash_grotesk"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="#D1DDE0"
                android:textSize="10sp" android:text="Rozpoczęcie: —" android:maxLines="1"/>
            <TextView android:id="@+id/wend" android:fontFamily="@font/clash_grotesk"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:gravity="end"
                android:textColor="#D1DDE0" android:textSize="10sp"
                android:text="Zakończenie: —" android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/wprimary" android:layout_width="match_parent"
            android:layout_height="30dp" android:orientation="horizontal" android:layout_marginTop="4dp">
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <Button android:id="@+id/wstartbutton" android:fontFamily="@font/clash_grotesk"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/widget_button" android:backgroundTint="@null"
                android:textColor="#304953" android:text="▶ ROZPOCZNIJ PRACĘ"
                android:textSize="11sp"/>
            <Button android:id="@+id/wstopbutton" android:fontFamily="@font/clash_grotesk"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/widget_active" android:backgroundTint="@null"
                android:textColor="#FFFFFF" android:text="■ ZAKOŃCZ PRACĘ"
                android:textSize="11sp" android:visibility="gone"/>
        </FrameLayout>
        <Button android:id="@+id/wcamera" android:layout_width="44dp" android:layout_height="match_parent"
            android:layout_marginStart="5dp" android:padding="0dp" android:minHeight="0dp"
            android:background="@drawable/widget_button" android:backgroundTint="@null"
            android:text="📷" android:contentDescription="@string/widget_camera" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/wactions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="3dp" android:visibility="gone">
            <Button android:id="@+id/wswitch" android:fontFamily="@font/clash_grotesk"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="26dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/widget_button" android:backgroundTint="@null"
                android:textColor="#304953" android:text="OBIEKT ↔" android:textSize="10sp"/>
            <Button android:id="@+id/wtravel" android:fontFamily="@font/clash_grotesk"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="26dp" android:layout_marginStart="5dp"
                android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/widget_button" android:backgroundTint="@null"
                android:textColor="#304953" android:text="PRZEJAZD" android:textSize="10sp"/>
            <Button android:id="@+id/wshopping" android:fontFamily="@font/clash_grotesk"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="26dp" android:layout_marginStart="5dp"
                android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/widget_button" android:backgroundTint="@null"
                android:textColor="#304953" android:text="ZAKUPY" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
