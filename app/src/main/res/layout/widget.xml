<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:padding="14dp" android:orientation="vertical" android:background="@drawable/widget_bg">
 <TextView android:id="@+id/wtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="R3 Gate" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp"/>
 <TextView android:id="@+id/wstatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● OFFLINE" android:textColor="#B9C3D0" android:paddingTop="6dp"/>
 <TextView android:id="@+id/wstart" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rozpoczęcie: —" android:textColor="#FFFFFF" android:paddingTop="7dp"/>
 <TextView android:id="@+id/wend" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Zakończenie: —" android:textColor="#FFFFFF"/>
 <Chronometer android:id="@+id/wduration" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="20sp" android:paddingTop="5dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">
  <Button android:id="@+id/wstartbutton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="ROZPOCZNIJ" android:textSize="10sp"/>
  <Button android:id="@+id/wstopbutton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="ZAKOŃCZ" android:textSize="10sp"/>
 </LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<Button android:id="@+id/wswitch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="OBIEKT" android:textSize="10sp"/>
<Button android:id="@+id/wtravel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="PRZEJAZD" android:textSize="10sp"/>
<Button android:id="@+id/wshopping" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="ZAKUPY" android:textSize="10sp"/>
</LinearLayout>
</LinearLayout>
