<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent">
 <ImageView android:id="@+id/wbackground" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
   <TextView android:fontFamily="@font/clash_grotesk" android:id="@+id/wtitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="WT" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
   <TextView android:fontFamily="@font/clash_grotesk" android:id="@+id/wstatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● OFFLINE" android:textColor="#CFD8DC" android:textSize="12sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
   <Chronometer android:fontFamily="@font/clash_grotesk" android:id="@+id/wduration" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="22sp"/>
   <Chronometer android:fontFamily="@font/clash_grotesk" android:id="@+id/wstage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF9898" android:textSize="11sp" android:visibility="gone"/>
  </LinearLayout>
  <TextView android:fontFamily="@font/clash_grotesk" android:id="@+id/wobject" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gotowy do pracy" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:fontFamily="@font/clash_grotesk" android:id="@+id/wstart" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rozpoczęcie: —" android:textColor="#CFD8DC" android:textSize="10sp"/>
  <TextView android:fontFamily="@font/clash_grotesk" android:id="@+id/wend" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Zakończenie: —" android:textColor="#CFD8DC" android:textSize="10sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp">
   <Button android:fontFamily="@font/clash_grotesk" android:id="@+id/wstartbutton" android:layout_width="match_parent" android:layout_height="28dp" android:minHeight="0dp" android:padding="0dp" android:background="@drawable/widget_button" android:backgroundTint="@null" android:textColor="#37474F" android:text="▶ ROZPOCZNIJ" android:textSize="11sp"/>
   <Button android:fontFamily="@font/clash_grotesk" android:id="@+id/wstopbutton" android:layout_width="match_parent" android:layout_height="28dp" android:minHeight="0dp" android:padding="0dp" android:background="@drawable/widget_active" android:backgroundTint="@null" android:textColor="#FFFFFF" android:text="■ ZAKOŃCZ PRACĘ" android:textSize="11sp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/wactions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp">
   <Button android:fontFamily="@font/clash_grotesk" android:id="@+id/wswitch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="28dp" android:minHeight="0dp" android:padding="0dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_button" android:backgroundTint="@null" android:textColor="#37474F" android:text="ZMIEŃ OBIEKT" android:textSize="10sp"/>
   <Button android:fontFamily="@font/clash_grotesk" android:id="@+id/wtravel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="28dp" android:minHeight="0dp" android:padding="0dp" android:background="@drawable/widget_button" android:backgroundTint="@null" android:textColor="#37474F" android:text="PRZEJAZD" android:textSize="10sp"/>
  </LinearLayout>
  <Button android:fontFamily="@font/clash_grotesk" android:id="@+id/wshopping" android:layout_width="match_parent" android:layout_height="28dp" android:minHeight="0dp" android:padding="0dp" android:layout_marginTop="4dp" android:background="@drawable/widget_button" android:backgroundTint="@null" android:textColor="#37474F" android:text="ZAKUPY" android:textSize="10sp"/>
 </LinearLayout>
</FrameLayout>
