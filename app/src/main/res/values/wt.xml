<resources>
    <string name="widget_description">WorkMeter — czas pracy i szybkie sterowanie</string>
    <style name="WTTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/clash_grotesk</item><item name="android:colorAccent">#32866E</item>
        <item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item><item name="android:windowBackground">#FFFFFF</item>
        <item name="android:alertDialogTheme">@style/WorkMeterDialogTheme</item>
        <item name="android:datePickerDialogTheme">@style/WorkMeterDialogTheme</item>
        <item name="android:timePickerDialogTheme">@style/WorkMeterDialogTheme</item>
    </style>
    <style name="WorkMeterDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#32866E</item><item name="android:fontFamily">@font/clash_grotesk</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item><item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#37474F</item><item name="android:textColorSecondary">#607D8B</item>
        <item name="android:editTextStyle">@style/WorkMeterDialogField</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/WorkMeterDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/WorkMeterDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/WorkMeterDialogButton</item>
    </style>
    <style name="WorkMeterDialogField" parent="android:style/Widget.Material.Light.EditText">
        <item name="android:background">@drawable/dialog_field</item><item name="android:textColor">#37474F</item>
        <item name="android:textColorHint">#607D8B</item><item name="android:textSize">16sp</item>
    </style>
    <style name="WorkMeterDialogButton" parent="android:style/Widget.Material.Light.Button.Borderless">
        <item name="android:textColor">#293F49</item><item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item><item name="android:minHeight">48dp</item>
    </style>
    <style name="WorkMeterNordicDialog" parent="@style/WorkMeterDialogTheme">
        <item name="android:colorAccent">#2563EB</item>
    </style>
    <style name="WorkMeterGraphiteDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/clash_grotesk</item>
        <item name="android:colorAccent">#54C6A1</item>
        <item name="android:colorBackground">#26343E</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B9CAD0</item>
    </style>
</resources>
